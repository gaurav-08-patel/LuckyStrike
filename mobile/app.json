{
  "expo": {
    "name": "LuckyStrike",
    "slug": "luckystrike",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/luckystrike_app_icon_1024x1024.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE8",
        "foregroundImage": "./assets/images/luckystrike_adaptive_foreground_1024x1024.png",
        "backgroundImage": "./assets/images/luckystrike_adaptive_background_1024x1024.png"
      },
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.luckystrike"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/luckystrike_splash_screen_1242x2688.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
